# Normalize text line endings in the repository.
* text=auto

# Windows batch files must keep CRLF in the working tree.
*.bat text eol=crlf

# Checksum manifests must stay LF so `sha256sum -c` works on every platform.
release/SHA256SUMS.txt text eol=lf

# Binary assets must never be line-ending converted.
*.png binary
*.ico binary
*.exe binary
